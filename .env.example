# Infomaniak Doc Assistant - Environment Configuration

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Options: ollama | qwen | mistral | openrouter
LLM_PROVIDER=openrouter

# -----------------------------------------------------------------------------
# Ollama Configuration (for local models)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Qwen API Configuration (for cloud - matches Qwen local)
# -----------------------------------------------------------------------------
QWEN_API_KEY=your-qwen-api-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-turbo
QWEN_EMBEDDING_MODEL=text-embedding-v3

# -----------------------------------------------------------------------------
# Mistral API Configuration (for cloud - matches Mistral local)
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed

# -----------------------------------------------------------------------------
# OpenRouter API Configuration
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_CHAT_MODEL=mistralai/ministral-8b
# v1: qwen/qwen3-embedding-8b (4096d) | v2: baai/bge-m3 (1024d) - selected automatically
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_SITE_URL=https://infomaniak-doc-assistant.demo
OPENROUTER_SITE_NAME=Infomaniak Doc Assistant

# =============================================================================
# Vector Database Configuration
# =============================================================================
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=infomaniak_docs

# =============================================================================
# Application Configuration
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# Observability (Optional)
# =============================================================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# RAG Configuration
# =============================================================================
# Architecture version: v1 (baseline) or v2 (BGE-M3 + reranking)
RAG_ARCHITECTURE_VERSION=v1

# Chunk strategy: "split" or "document" (whole FAQ)
RAG_CHUNK_STRATEGY=split
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_VECTOR_DIMENSION=4096

# Hybrid search (BM25 + vector)
RAG_HYBRID_ENABLED=true
RAG_BM25_K=60

# -----------------------------------------------------------------------------
# V2 Architecture Settings (requires RAG_ARCHITECTURE_VERSION=v2)
# -----------------------------------------------------------------------------
# Reranking with cross-encoder (runs locally)
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_N=5

# Contextual retrieval preprocessing
RAG_CONTEXTUAL_ENABLED=false

# =============================================================================
# Scraping (Jina Reader API)
# =============================================================================
JINA_API_KEY=your-jina-api-key
