# =============================================================================
# Infomaniak Doc Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: This project uses OpenRouter for LLM access. All evaluation metrics
# were benchmarked with OpenRouter models. Using different providers may yield
# different quality results.
#
# For Docker: QDRANT_HOST is auto-configured, you only need OPENROUTER_API_KEY

# =============================================================================
# Required: LLM API Key
# =============================================================================
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Provider: ollama (local) | openrouter (cloud)
LLM_PROVIDER=openrouter

# Generation model for chat responses (evaluation winner: best quality/cost ratio)
GENERATION_MODEL=mistralai/mistral-nemo

# Fallback model for complex queries (flagship quality)
FALLBACK_MODEL=mistralai/mistral-large

# Embedding model (evaluation: 2560 dimensions)
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-4b

# Judge model for LLM-as-judge evaluation
JUDGE_MODEL=google/gemini-3-flash-preview

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
# For local development: http://localhost:6333
# For Docker: automatically set to http://qdrant:6333
QDRANT_HOST=http://localhost:6333

# Default collection (evaluation winner: hybrid search with full documents)
QDRANT_COLLECTION=infomaniak_hybrid_full_doc_no_images

# =============================================================================
# RAG Configuration (evaluation-optimized defaults)
# =============================================================================
# Chunking: full_document won - FAQs are atomic units
CHUNKING_STRATEGY=full_document

# Dataset: cleaned_no_images won - 12% smaller, cleaner text
DATASET_PATH=cleaned_no_images

# Vector dimension for qwen/qwen3-embedding-4b
RAG_VECTOR_DIMENSION=2560

# Retrieval settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# =============================================================================
# Hybrid Search
# =============================================================================
# HyDE model for hypothetical document embeddings (optional, adds latency)
# HYDE_MODEL=mistralai/mistral-nemo

# =============================================================================
# Observability (Langfuse) - Optional
# =============================================================================
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com
